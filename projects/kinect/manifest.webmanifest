{
  "id": "./",
  "name": "Kinetic — Hand Tracking Arcade",
  "short_name": "Kinetic",
  "description": "Catch glowing orbs with your hands using on-device gesture recognition.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "categories": ["games", "entertainment"],
  "background_color": "#070b16",
  "theme_color": "#070b16",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Classic", "short_name": "Classic", "url": "./index.html?mode=classic" },
    { "name": "Time Attack", "short_name": "Time", "url": "./index.html?mode=time" },
    { "name": "Gesture Combo", "short_name": "Gestures", "url": "./index.html?mode=gesture" }
  ]
}
