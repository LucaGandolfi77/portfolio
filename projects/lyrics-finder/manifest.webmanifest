{
  "id": "./",
  "name": "Reverse Lyrics Finder — find the song from a line",
  "short_name": "Lyrics Finder",
  "description": "Paste a line of lyrics, find the song, preview it and read the full text with your phrase highlighted.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070d18",
  "theme_color": "#0b1220",
  "categories": ["music", "utilities", "search"],
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
