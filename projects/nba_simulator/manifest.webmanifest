{
  "id": "./",
  "name": "NBA Broadcast Simulator",
  "short_name": "NBA Sim",
  "description": "30-team basketball simulator with tactics, franchise mode, advanced analytics and offline play.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "en",
  "categories": [
    "games",
    "sports",
    "entertainment"
  ],
  "background_color": "#070c1c",
  "theme_color": "#0a0e1f",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Play",
      "short_name": "Play",
      "url": "./index.html?view=match"
    },
    {
      "name": "Season",
      "short_name": "Season",
      "url": "./index.html?view=season&sub=season"
    },
    {
      "name": "Team",
      "short_name": "Team",
      "url": "./index.html?view=team&sub=teams"
    },
    {
      "name": "Cards",
      "short_name": "Cards",
      "url": "./index.html?view=cards"
    }
  ]
}
