{
  "id": "./",
  "name": "NBA Simulator — Broadcast Edition",
  "short_name": "NBA Sim",
  "description": "Simulatore NBA: campo animato, play-by-play, stagione, playoff, roster editor e statistiche avanzate. PWA offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0e1f",
  "theme_color": "#0a0e1f",
  "lang": "it",
  "categories": ["games", "sports", "entertainment"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Partita", "short_name": "Partita", "url": "./index.html?view=match", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stagione", "short_name": "Stagione", "url": "./index.html?view=season", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistiche", "short_name": "Stats", "url": "./index.html?view=stats", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
