{
  "name": "verso-il-17",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Il diario segreto del Monza Precision Team verso i Campionati del Mondo di pattinaggio artistico a rotelle sincronizzato in Paraguay.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && BASE_PATH=\"${BASE_PATH:-/portfolio/verso-il-17/}\" vite build --outDir ../../verso-il-17 --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --experimental-strip-types --test src/utils/dates.test.ts src/data/event.test.ts"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.6",
    "npm": ">=10"
  }
}
