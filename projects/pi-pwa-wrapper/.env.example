# pi-pwa-wrapper server configuration.
# Copy to .env and export, or pass inline. There is no dotenv dependency:
# the server reads these from the environment directly.

# Where to listen (default 0.0.0.0:8787)
# HOST=127.0.0.1
# PORT=8787

# Root directory the browser may pick workspaces from (default: server cwd).
# Only this directory and its immediate subdirectories are offered.
# PI_PWA_ROOT=/home/you/projects

# Optional access token: if set, clients must connect to /ws?token=...
# PI_PWA_TOKEN=change-me

# How to launch pi (default: auto-detect). Use an executable name/path, or a
# .js/.cjs/.mjs file path that gets run with the current node binary.
# PI_BINARY=/usr/local/bin/pi

# Extra CLI args passed to EVERY agent, e.g. to load an extension:
# PI_ARGS="--extension /home/you/projects/pi-pwa-wrapper/examples-extension/pwa-demo.js"

# Model credentials are inherited from the environment (e.g. ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, DEEPSEEK_API_KEY …) — run `pi auth` once to set them up.
