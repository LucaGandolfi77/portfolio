{
  "name": "pi-pwa-wrapper",
  "version": "1.0.0",
  "description": "A PWA shell for the Pi coding agent: stream pi --mode rpc into a browser chat with tools, thinking, extension dialogs, model switching and workspace selection.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "icons": "node scripts/make-icons.mjs",
    "test:bridge": "node scripts/smoke.mjs",
    "test:ext": "node scripts/smoke-ext.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "keywords": ["pi", "pwa", "agent", "rpc", "coding", "chat"],
  "license": "MIT"
}
