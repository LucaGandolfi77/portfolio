{
  "name": "Pixel Studio — Photo & Pixel Editor",
  "short_name": "Pixel Studio",
  "description": "Offline photo and pixel editor with layers, blend modes, filters, text, stickers and multi-format export.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b16",
