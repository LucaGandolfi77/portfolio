{
  "name": "la-corona-e-la-testa-v2",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "kit": "${BLENDER:-blender} -b --factory-startup --python blender/build_kit.py && gltfpack -i blender/kit.raw.glb -o public/models/kit.glb -cc -kn -kv -vtf"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "gltfpack": "^0.25.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "portfolio": {
    "build": "build",
    "test": "test",
    "out": "dist",
    "publishAt": "projects/la-corona-e-la-testa-v2"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
