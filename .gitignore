# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.env

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Node (se futuri tooling) ---
node_modules/
npm-debug.log*
.npm/
*.tsbuildinfo

# --- Backup / temporanei del sito ---
*.bak
*.backup
*~
*.tmp
*.log

# --- PWA compilata per GitHub Pages ---
# Generata da `npm run build:pages` dentro projects/verso-il-17.
# Non va committata: la produce la CI prima di pubblicare.
/verso-il-17/

# --- Output build vari ---
# Vite/React: `dist`, `build`, e le copie TWA (scripts/build-twa.sh).
# Nota: `build/` da solo NON copre `build-twa/`, servono entrambi.
dist/
build/
build-twa/
dev-dist/

# Vite outDir custom: games/coverage-galaxy/build.config.ts usa outDir:'site'.
# Il sorgente React resta tracciato in src/, quindi `site/` si rigenera con
# `npm run build`. NON ignorare games/wikithriving/site/: quel path è sorgente
# hand-written (non ha script di build), non output.
/games/coverage-galaxy/site/

# --- Segreti: mai committati, mai pubblicati ---
.env
.env.*
!.env.example
*.pem
*.key
!*.pub.pem

# Firme di rilascio Android: la chiave non deve stare in git, altrimenti chi
# clona puo' firmare APK al posto dell'autore. Vedi scripts/extract-fingerprint.sh
# per rigenerare .well-known/assetlinks.json dopo una rotazione.
# NOTA: projects/shhh-reader/shhh-release.keystore e' ancora tracciato perche'
# rimuoverlo invalida gli aggiornamenti Play Store gia' pubblicati. La chiave
# va ruotata con upload key separata, non semplicemente rimossa.
*.keystore
*.jks

# --- Config locali del book-writer (chiavi API, path assoluti) ---
book-writer/book_writer_config.json

# Harnesses
deepseek-harness/

# Random / misc
random/
