# Normalizza i fine-riga: su Windows i file LF diventerebbero CRLF e ogni
# diff mostrerebbe il file intero come modificato.
* text=auto eol=lf

# Binari: mai toccati da conversioni di fine-riga.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.avif     binary
*.ico      binary
*.mp3      binary
*.wav      binary
*.ogg      binary
*.mp4      binary
*.webm     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.gba      binary
*.glb      binary
*.gltf     binary
*.pdf      binary
*.keystore binary
*.jar      binary
*.apk      binary
*.aab      binary
*.ipa      binary
*.zip      binary

# Lockfile e generated assets da non normalizzare.
package-lock.json      -diff
**/package-lock.json   -diff

# Documentazione e test sorgente: diff/testo sempre affidabili.
