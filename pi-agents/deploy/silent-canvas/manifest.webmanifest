{
  "name": "Silent Canvas — Create in silence",
  "short_name": "Silent Canvas",
  "description": "A noise-gated, offline-first creation studio for artists. Draw, paint, and edit only when ambient noise is below your threshold. Zero data, zero backend, zero account.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["productivity", "creativity", "lifestyle"],
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    { "src": "./icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "./icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Enter Studio",
      "short_name": "Studio",
      "url": "/?action=studio",
      "description": "Open the noise-gated creation studio",
      "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": [".png", ".jpg", ".jpeg", ".webp"] }]
    }
  },
  "widgets": [
    {
      "name": "Quiet Minutes",
      "description": "Today's silent creation minutes",
      "type": "daily",
      "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192", "purpose": "any" }],
      "activity": { "navigation": { "href": "/" } },
      "data": { "default": { "value": "0", "label": "quiet minutes" } }
    }
  ],
  "screenshots": [
    {
      "src": "./icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Silent Canvas — Create in silence"
    }
  ]
}