{
  "name": "SHHH – Leggi in silenzio",
  "short_name": "SHHH",
  "description": "Il primo lettore che ha bisogno di silenzio. Il rumore punisce la lettura.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["books", "productivity", "lifestyle"],
  "lang": "it",
  "dir": "ltr",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Nuova lettura",
      "short_name": "Nuova",
      "url": "./?action=new",
      "description": "Apri un nuovo documento",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Browser",
      "short_name": "Browser",
      "url": "./?tab=browser",
      "description": "Vai al browser integrato",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Statistiche",
      "short_name": "Stats",
      "url": "./?tab=stats",
      "description": "Vedi le tue statistiche silenziose",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SHHH – Leggi in silenzio"
    }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [".pdf", ".epub", ".txt", ".md", ".html"]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "SHHH Daily Stats",
      "description": "Daily silence reading statistics",
      "type": "daily",
      "data": { "default": { "value": "0s", "label": "silence seconds" } },
      "activity": { "navigation": { "href": "/app/" } },
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }]
    }
  ]
}