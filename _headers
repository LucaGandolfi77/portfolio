# GitHub Pages custom headers (processed by Jekyll build).
# Site-wide security headers that are safe for every page.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Homepage only: stricter CSP aligned with the endpoints index.html actually uses.
# (Games/projects intentionally keep the permissive default so CDNs, WebRTC,
#  iframes and dynamic imports keep working.)

/
  Content-Security-Policy: default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.emailjs.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://pollinations.ai https://text.pollinations.ai https://api.emailjs.com https://www.google.com; frame-src 'self' https://www.google.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:;

/index.html
  Content-Security-Policy: default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.emailjs.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://pollinations.ai https://text.pollinations.ai https://api.emailjs.com https://www.google.com; frame-src 'self' https://www.google.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:;
