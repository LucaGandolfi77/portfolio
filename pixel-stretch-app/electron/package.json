{
  "name": "pixel-stretch-desktop",
  "productName": "Pixel Stretch",
  "version": "1.0.0",
  "description": "Pixel Stretch photo editor — desktop app (Electron)",
  "author": "Pixel Stretch",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pixelstretch.editor",
    "productName": "Pixel Stretch",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": ["dmg", "zip"],
      "icon": "../public/icon-512.png"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics"
    }
  }
}
