{
  "name": "after-dusk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "After Dusk — A first-person 3D psychological thriller PWA about overcoming the fear of dark shadows at night.",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "kit": "node scripts/kit-manifest.mjs && ${BLENDER:-blender} -b --factory-startup --python blender/build_all.py && node scripts/pack-kit.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "gltfpack": "^0.25.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4"
  },
  "portfolio": {
    "build": "build",
    "test": "test",
    "out": "dist",
    "publishAt": "games/after-dusk"
  }
}
