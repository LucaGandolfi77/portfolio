{
  "id": "./",
  "name": "Snake Neon — 7 modalità PWA",
  "short_name": "Snake Neon",
  "description": "Snake moderno: 7 modalità, power-up, eventi live, sfida giornaliera, classifica e gioco offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#06131d",
  "theme_color": "#06131d",
  "lang": "it",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Classica", "short_name": "Classica", "url": "./index.html?mode=classic", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sprint 60s", "short_name": "Sprint", "url": "./index.html?mode=sprint", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Battle vs CPU", "short_name": "Battle", "url": "./index.html?mode=battle", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sfida giornaliera", "short_name": "Daily", "url": "./index.html?daily=1", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
