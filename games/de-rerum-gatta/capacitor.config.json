{
  "appId": "com.lucagandolfi.dererumgatta",
  "appName": "De Rerum Gatta",
  "webDir": "www",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "backgroundColor": "#fdf6ec",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#fdf6ec"
    },
    "Haptics": {
      "defaultVibration": 10
    },
    "App": {
      "launchUrl": "https://lucagandolfi77.github.io/portfolio/games/de-rerum-gatta/"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#e8a87c"
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "minimumWebDeploymentVersion": "14",
    "contentInset": "automatic",
    "backgroundColor": "#fdf6ec",
    "preferredContentMode": "mobile"
  }
}
