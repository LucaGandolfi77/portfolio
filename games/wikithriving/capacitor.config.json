{
  "appId": "com.lucagandolfi.wikithriving",
  "appName": "WikiThriving",
  "webDir": "site",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 2000, "backgroundColor": "#d4a54a", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#d4a54a" },
    "Haptics": { "defaultVibration": 10 },
    "App": { "launchUrl": "https://lucagandolfi77.github.io/portfolio/games/wikithriving/site/" },
    "LocalNotifications": { "smallIcon": "ic_stat_icon_config_sample", "iconColor": "#d4a54a" }
  },
  "android": { "allowMixedContent": true },
  "ios": {
    "minimumWebDeploymentVersion": "14",
    "contentInset": "automatic",
    "backgroundColor": "#faf6ee",
    "preferredContentMode": "mobile"
  }
}
