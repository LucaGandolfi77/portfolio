{
  "name": "bucio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BUCIO — un buco nero low-poly che divora una cittadina italiana",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node scripts/smoke-modes.mjs",
    "typecheck": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom,dom.iterable src/main.js",
    "kit": "${BLENDER:-blender} -b --factory-startup --python blender/build_kit.py && gltfpack -i blender/kit.raw.glb -o public/models/kit.glb -cc -kn -kv -vtf"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "gltfpack": "^0.25.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "portfolio": {
    "build": "build",
    "test": "test",
    "out": "dist",
    "publishAt": "games/bucio"
  }
}
