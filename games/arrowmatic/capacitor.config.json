{
  "appId": "com.lucagandolfi.arrowmatic",
  "appName": "Arrowmatic",
  "webDir": ".",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#12123a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#12123a"
    },
    "Haptics": {
      "defaultVibration": 10
    },
    "App": {
      "launchUrl": "https://lucagandolfi77.github.io/portfolio/games/arrowmatic/"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#ff5ea8"
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "minimumWebDeploymentVersion": "14",
    "contentInset": "automatic",
    "backgroundColor": "#12123a",
    "preferredContentMode": "mobile"
  }
}
