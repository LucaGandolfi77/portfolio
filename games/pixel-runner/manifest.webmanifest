{
  "id": "./",
  "name": "Pixel Runner — Arcade",
  "short_name": "Pixel Runner",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080b1f",
  "theme_color": "#080b1f",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
