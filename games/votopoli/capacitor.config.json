{
  "appId": "com.lucagandolfi.votopoli",
  "appName": "Votopoli",
  "webDir": ".",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 2000, "backgroundColor": "#FF9500", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#FF9500" },
    "Haptics": { "defaultVibration": 10 },
    "App": { "launchUrl": "https://lucagandolfi77.github.io/portfolio/games/votopoli/" },
    "LocalNotifications": { "smallIcon": "ic_stat_icon_config_sample", "iconColor": "#FF9500" }
  },
  "android": { "allowMixedContent": true },
  "ios": {
    "minimumWebDeploymentVersion": "14",
    "contentInset": "automatic",
    "backgroundColor": "#FFF8E7",
    "preferredContentMode": "mobile"
  }
}
