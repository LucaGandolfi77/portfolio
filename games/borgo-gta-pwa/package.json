{
  "name": "borgo-gta-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BORGO NOTTE — an original open-world driving game on the real streets of Fidenza: steal a ride, run deliveries and taxi fares, shake off the police and tune the procedural radio. Mobile-first PWA.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "portfolio": {
    "build": "build",
    "test": "test",
    "out": "dist",
    "publishAt": "games/borgo-gta-pwa"
  }
}
