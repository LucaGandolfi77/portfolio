{
  "appId": "com.lucagandolfi.quotesmith",
  "appName": "QuoteSmith",
  "webDir": "www",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "backgroundColor": "#101417",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#101417"
    },
    "Haptics": {
      "defaultVibration": 10
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "minimumWebDeploymentVersion": "14",
    "contentInset": "automatic",
    "backgroundColor": "#101417",
    "preferredContentMode": "mobile"
  }
}