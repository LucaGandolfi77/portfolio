{
  "id": "./",
  "name": "Court Clash — NBA Chest Collector",
  "short_name": "Court Clash",
  "description": "Bet virtual coins on quick NBA matches, build a 5-card lineup, win chests, collect 300 cards, climb arenas and complete missions. Offline PWA, no real money.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en",
  "categories": ["games", "sports", "entertainment"],
  "background_color": "#071120",
  "theme_color": "#081426",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Play",
      "short_name": "Play",
      "url": "./index.html#play"
    },
    {
      "name": "Chests",
      "short_name": "Chests",
      "url": "./index.html#chests"
    },
    {
      "name": "Cards",
      "short_name": "Cards",
      "url": "./index.html#cards"
    },
    {
      "name": "Profile",
      "short_name": "Profile",
      "url": "./index.html#profile"
    }
  ]
}
