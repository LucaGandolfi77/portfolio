{
  "name": "brick-wilds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Brick-Wilds: Synth-Beast Chronicles — An isometric 3D brick-built diorama action-adventure PWA with elemental weak-point combat, Hearth-Haven village customization, and 2-player local co-op.",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4"
  },
  "portfolio": {
    "build": "build",
    "test": "test",
    "out": "dist",
    "publishAt": "games/brick-wilds"
  }
}
