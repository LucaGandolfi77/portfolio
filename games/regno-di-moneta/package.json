{
  "name": "regno-di-moneta",
  "version": "1.0.0",
  "description": "Educazione finanziaria gamificata — Il Regno di Moneta",
  "author": "Luca Gandolfi",
  "license": "MIT",
  "homepage": "https://lucagandolfi77.github.io/portfolio/games/regno-di-moneta/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucagandolfi77/portfolio.git",
    "directory": "games/regno-di-moneta"
  },
  "scripts": {
    "build": "echo 'Static site — no build needed'",
    "deploy": "git subtree push --prefix games/regno-di-moneta origin gh-pages",
    "cap:init": "npx cap init 'Il Regno di Moneta' com.lucagandolfi.regnodimoneta --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "lint": "echo 'No linter configured — check manually'",
    "test:js": "for f in js/*.js; do node --check \"$f\" || exit 1; done && echo 'All JS files OK'"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "educazione finanziaria",
    "financial literacy",
    "gamification",
    "pwa",
    "idle game",
    "capacitor"
  ]
}
